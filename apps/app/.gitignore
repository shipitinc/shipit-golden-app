# Flutter/Dart
.dart_tool/
.packages
build/
*.dart_tool/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Pubspec lock (ignored - managed by melos bootstrap)
pubspec.lock

# Coverage
coverage/
*.lcov

# Logs
*.log

# Flutter tool-generated per-machine/platform files
# Android (android/.gitignore) and iOS (ios/.gitignore) carry their own
# machine-local ignore rules (local.properties, Flutter/, etc.).
.flutter-plugins-dependencies

# Golden failure artifacts (local diagnostic only; CI uploads them as artifacts)
test/goldens/failures/

# Freezed / json_serializable generated code — regenerate with `melos run generate:freezed`
*.freezed.dart
*.g.dart